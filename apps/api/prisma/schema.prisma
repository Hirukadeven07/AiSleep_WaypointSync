generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  dispatcher
  store
  loader
  driver
}

enum Brand {
  Fresh
  Style
  Tech
}

/// Booklet product class on the catalogue row (Fresh stores mix chilled food and ambient fresh).
enum ItemType {
  chilled_food
  fresh
  style
  tech
}

enum Temp {
  chilled
  ambient
}

enum VehicleType {
  truck
  van
}

enum VehicleTemp {
  reefer
  ambient
}

enum DockType {
  rear_dock
  street
  mall_bay
}

enum ParkingConstraint {
  normal
  van_only
  mall_dock
}

enum OrderStatus {
  waiting
  planned
  deferred
  delivered
  partial
}

/// How short the store is when it marks an order urgent.
enum StockLevel {
  out_of_stock
  running_low
}

enum TripStatus {
  planning
  published
  loading
  ready
  on_road
  completed
  breakdown
}

enum StopStatus {
  upcoming
  arrived
  waiting
  confirmed
  delivered
  partial
  deferred
  at_risk
}

enum VehicleStatus {
  available
  out_of_service
  on_road
}

enum FlagType {
  missing
  damaged
  wrong_quantity
}

enum IncidentType {
  breakdown
  delay
  quiet_driver
  wait_timeout
}

/// Outlet phone label (ERD OutletPhone).
enum PhoneLabel {
  shop
  manager
  warehouse
}

enum LoaderShift {
  morning
  night
}

enum LoaderNoteRole {
  picking
  confirming
}

/// Driver accept/reject of a store-raised FieldFlag. Drivers cannot raise FieldFlags.
enum FieldFlagDecision {
  pending
  accepted
  rejected
}

enum LoaderFlagScope {
  item
  dn
}

enum LoaderFlagStatus {
  pending_dispatcher
  approved
  rejected
}

enum LoadingJobStatus {
  assigned
  picking
  loaded
  handed_over
  cancelled
}

enum FlagSeverity {
  low
  medium
  high
}

enum SosSeverity {
  low
  high
  critical
}

model Depot {
  id        String     @id
  name      String
  districts District[]
  stores    Store[]
  users     User[]
  vehicles  Vehicle[]
  trips     Trip[]
}

model District {
  id                 String  @id @default(cuid())
  name               String  @unique
  depotId            String?
  depot              Depot?  @relation(fields: [depotId], references: [id])
  served             Boolean @default(true)
  roadClass          String?
  freeFlowKmh        Float?
  depotToDistrictKm  Float?
  depotToDistrictMin Int?
  interStopKm        Float?
  interStopMin       Int?
  stores             Store[]
  trips              Trip[]
}

model ServiceAllowance {
  id       String   @id @default(cuid())
  brand    Brand
  dockType DockType
  minutes  Int

  @@unique([brand, dockType])
}

model CalendarDay {
  id           DateTime @id @db.Date
  dow          Int
  isWeekend    Boolean
  isoYear      Int
  isoWeek      Int
  isPayday     Boolean
  festival     String?
  festivalRamp Float    @default(0)
  isHoliday    Boolean
  monsoon      Boolean
  isOperating  Boolean
}

model TrafficSpeed {
  id           String   @id @default(cuid())
  districtName String
  hour         Int?
  monsoon      Boolean?
  speedIndex   Float?
  raw          Json
}

model RoadCondition {
  id              String   @id @default(cuid())
  date            DateTime @db.Date
  districtName    String
  disruptionIndex Float?
  raw             Json
}

/// Running app table for ERD Outlet. Keep the name Store so existing Nest code stays valid.
model Store {
  id                String            @id
  displayName       String?
  brand             Brand
  districtId        String
  district          District          @relation(fields: [districtId], references: [id])
  depotId           String
  depot             Depot             @relation(fields: [depotId], references: [id])
  dockType          DockType
  parkingConstraint ParkingConstraint @default(normal)
  mallWindow        String?
  windowOpenMin     Int
  windowCloseMin    Int
  lat               Float?
  lng               Float?
  phone             String?
  orders            Order[]
  users             User[]
  phones            OutletPhone[]
  fieldFlags        FieldFlag[]
}

model User {
  id                 String         @id @default(cuid())
  loginId            String         @unique
  role               Role
  name               String
  depotId            String?
  depot              Depot?         @relation(fields: [depotId], references: [id])
  storeId            String?
  store              Store?         @relation(fields: [storeId], references: [id])
  passwordHash       String?
  pinHash            String?
  phone              String?
  sessions           Session[]
  vehicle            Vehicle?
  notifications      Notification[]
  driverProfile      Driver?
  loaderProfile      Loader?
  dispatcherProfile  Dispatcher?
  assignedTrips      Trip[]         @relation("TripAssignedDriver")
  events             DriverEvent[]
  signedReceipts     StoreReceipt[]
}

model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime
}

model Vehicle {
  id                 String           @id
  plate              String?          @unique
  depotId            String
  depot              Depot            @relation(fields: [depotId], references: [id])
  type               VehicleType
  temp               VehicleTemp
  weightCapKg        Float
  volumeCapM3        Float
  fuelType           String?
  kmPerL             Float?
  weeklyFuelQuotaL   Float?
  status             VehicleStatus    @default(available)
  outOfServiceReason String?
  returnDate         DateTime?        @db.Date
  lastConfirmedLitres Float?
  driverId           String?          @unique
  driver             User?            @relation(fields: [driverId], references: [id])
  trips              Trip[]
  incidents          DriverIncident[]
}

model Order {
  id                  String         @id @default(cuid())
  storeId             String
  store               Store          @relation(fields: [storeId], references: [id])
  brand               Brand
  deliveryDate        DateTime       @db.Date
  temp                Temp
  status              OrderStatus    @default(waiting)
  units               Int
  weightKg            Float
  volumeM3            Float
  urgentNote          String?
  /// Set by the store at order time; urgent orders head the dispatcher's waiting list.
  urgent              Boolean        @default(false)
  stockLevel          StockLevel?
  movedFromDate       DateTime?      @db.Date
  deferReason         String?
  deferredById        String?
  deferredYesterday   Boolean        @default(false)
  daysSinceLastServed Int?
  repeatSkip          Boolean        @default(false)
  createdAt           DateTime       @default(now())
  lines               OrderLine[]
  stop                TripStop?
  deliveryNotes       DeliveryNote[]
  fieldFlags          FieldFlag[]

  @@index([deliveryDate, status])
}

model OrderLine {
  id           String     @id @default(cuid())
  orderId      String
  order        Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemId       String?
  item         Item?      @relation(fields: [itemId], references: [id])
  name         String
  qty          Int
  pack         String
  chilled      Boolean    @default(false)
  unitWeightKg Float
  unitVolumeM3 Float
  flags        LoadFlag[]
}

model Trip {
  id                    String           @id @default(cuid())
  vehicleId             String
  vehicle               Vehicle          @relation(fields: [vehicleId], references: [id])
  assignedDriverId      String?
  assignedDriver        User?            @relation("TripAssignedDriver", fields: [assignedDriverId], references: [id])
  depotId               String
  depot                 Depot            @relation(fields: [depotId], references: [id])
  brand                 Brand
  districtId            String
  district              District         @relation(fields: [districtId], references: [id])
  serviceDate           DateTime         @db.Date
  tripNumber            Int
  csvRouteId            String?
  status                TripStatus       @default(planning)
  planVersion           Int              @default(1)
  plannedMinutes        Int?
  plannedLitres         Float?
  /// Latest FUEL_READING synced for this trip; once the trip ends it is the end-of-trip fuel.
  fuelLitresAtEnd       Float?
  publishedAt           DateTime?
  tripStartingDate      DateTime?        @db.Date
  tripEndingDate        DateTime?        @db.Date
  startingTime          DateTime?
  estimatedStartingTime DateTime?
  endingTime            DateTime?
  stops                 TripStop[]
  loadSession           LoadSession?
  loadingJob            LoadingJob?
  events                DriverEvent[]
  incidents             Incident[]
  routeLegs             RouteLeg[]
  locationPings         LocationPing[]
  fieldFlags            FieldFlag[]
  driverIncidents       DriverIncident[] @relation("DriverIncidentTrip")
  reassignedIncidents   DriverIncident[] @relation("DriverIncidentReassign")

  @@unique([vehicleId, serviceDate, tripNumber])
  @@index([depotId, serviceDate])
}

model TripStop {
  id                      String           @id @default(cuid())
  tripId                  String
  trip                    Trip             @relation(fields: [tripId], references: [id], onDelete: Cascade)
  orderId                 String           @unique
  order                   Order            @relation(fields: [orderId], references: [id])
  sequence                Int
  status                  StopStatus       @default(upcoming)
  etaMin                  Int?
  arrivedAt               DateTime?
  storeConfirmedAt        DateTime?
  driverAckAt             DateTime?
  plannedArrivalTime      DateTime?
  leaveOutletTime         DateTime?
  serviceMin              Float?
  unloadingTime           Float?
  estimatedUnloadingTime  Float?
  estimatedTripStopTime   DateTime?
  tripStopTime            DateTime?
  tripStartTime           DateTime?
  estimatedTripStartTime  DateTime?
  flags                   LoadFlag[]
  receipt                 StoreReceipt?
  lastStopIncidents       DriverIncident[]

  @@unique([tripId, sequence])
}

model LoadSession {
  id               String    @id @default(cuid())
  tripId           String    @unique
  trip             Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  loaderIds        String[]
  startedAt        DateTime?
  finishedAt       DateTime?
  departedAt       DateTime?
  paused           Boolean   @default(false)
  ackedPlanVersion Int       @default(0)
  /// Order ids on the trip when the loader last acknowledged; diffed against the live trip for the plan-change lock.
  ackedStopIds     String[]  @default([])
  /// Removed orders the loader has confirmed are off the truck; acknowledging needs all of them. Reset on acknowledge.
  takenOffOrderIds String[]  @default([])
  /// Orders added by the last acknowledged plan change, shown as NEW on the checklist. Cleared on depart.
  newOrderIds      String[]  @default([])
}

model LoadFlag {
  id          String     @id @default(cuid())
  stopId      String
  stop        TripStop   @relation(fields: [stopId], references: [id], onDelete: Cascade)
  orderLineId String?
  orderLine   OrderLine? @relation(fields: [orderLineId], references: [id])
  type        FlagType
  qty         Int?
  note        String?
  photoKey    String?
  createdAt   DateTime   @default(now())
}

model StoreReceipt {
  id                 String    @id @default(cuid())
  stopId             String    @unique
  stop               TripStop  @relation(fields: [stopId], references: [id], onDelete: Cascade)
  lineResults        Json
  chilledWasCold     Boolean?
  photoKey           String?
  signaturePhotoKey  String?
  signedByUserId     String?
  signedBy           User?     @relation(fields: [signedByUserId], references: [id], onDelete: SetNull)
  signedAt           DateTime?
  createdAt          DateTime  @default(now())
}

model DriverEvent {
  id               String    @id @default(cuid())
  clientId         String    @unique
  driverId         String
  driver           User      @relation(fields: [driverId], references: [id])
  tripId           String?
  trip             Trip?     @relation(fields: [tripId], references: [id])
  type             String
  payload          Json
  createdOnPhoneAt DateTime
  seenPlanVersion  Int?
  appliedAt        DateTime  @default(now())

  @@index([driverId, type, appliedAt])
}

model Incident {
  id        String       @id @default(cuid())
  type      IncidentType
  tripId    String
  trip      Trip         @relation(fields: [tripId], references: [id])
  status    String
  timeline  Json
  createdAt DateTime     @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

// --- Team ERD (waypoint schema team version.drawio) --------------------------------
// Store = Outlet. User.role + Driver/Loader/Dispatcher profiles = login people.
// LoadSession stays as the live dock; LoadingJob is the dispatcher handoff row.

model OutletPhone {
  id      String     @id @default(cuid())
  storeId String
  store   Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  phoneNo String
  label   PhoneLabel
}

model Item {
  id           String           @id
  itemName     String
  brand        Brand            @default(Fresh)
  type         ItemType         @default(fresh)
  isChilled    Boolean          @default(false)
  packLabel    String?
  packWeightKg Float?
  orderLines   OrderLine[]
  batches      InventoryBatch[]
  dnLines      DeliveryNoteLine[]
  fieldFlags   FieldFlag[]
  loaderFlags  LoaderFlag[]

  @@index([brand, type])
}

model InventoryBatch {
  id                String             @id @default(cuid())
  itemId            String
  item              Item               @relation(fields: [itemId], references: [id])
  batchName         String?
  manufacturingDate DateTime?          @db.Date
  expiryDate        DateTime?          @db.Date
  qty               Float              @default(0)
  picks             DeliveryNotePick[]
}

/// 1:1 with User where role = driver. Vehicle assignment stays on Vehicle.driverId.
model Driver {
  id            String           @id @default(cuid())
  userId        String           @unique
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  licenseNo     String?          @unique
  idNo          String?          @unique
  joinDate      DateTime?        @db.Date
  leavingDate   DateTime?        @db.Date
  lastLoginAt   DateTime?
  isActive      Boolean          @default(true)
  phones        DriverPhone[]
  incidents     DriverIncident[]
  locationPings LocationPing[]
}

model DriverPhone {
  phoneNumber String @id
  driverId    String
  driver      Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)
}

model Loader {
  id            String               @id @default(cuid())
  userId        String               @unique
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeNo    String?              @unique
  idNo          String?              @unique
  shift         LoaderShift?
  joinDate      DateTime?            @db.Date
  leavingDate   DateTime?            @db.Date
  lastLoginAt   DateTime?
  isActive      Boolean              @default(true)
  notesChanged  DeliveryNote[]
  assignments   DeliveryNoteLoader[]
  flags         LoaderFlag[]
}

model Dispatcher {
  id          String       @id @default(cuid())
  userId      String       @unique
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeNo  String?      @unique
  lastLoginAt DateTime?
  isActive    Boolean      @default(true)
  loadingJobs LoadingJob[]
  reviews     LoaderFlag[]
}

model RouteLeg {
  id                String    @id @default(cuid())
  tripId            String
  trip              Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  seq               Int
  fromPoint         String?
  toOutlet          String?
  distanceKm        Float?
  plannedDepartTime DateTime?
  plannedTravelMin  Float?
  actualDepartTime  DateTime?
  actualTravelMin   Float?
  monsoon           Boolean?
  trafficBand       String?

  @@unique([tripId, seq])
}

/// Dispatcher → loader handoff for a trip. LoadSession is the live dock progress.
model LoadingJob {
  id            String           @id @default(cuid())
  tripId        String           @unique
  trip          Trip             @relation(fields: [tripId], references: [id], onDelete: Cascade)
  depot         String
  assignedById  String
  assignedBy    Dispatcher       @relation(fields: [assignedById], references: [id])
  assignedAt    DateTime         @default(now())
  bay           String?
  loadByTime    DateTime?
  instructions  String?
  priority      Int              @default(0)
  status        LoadingJobStatus @default(assigned)
  startedAt     DateTime?
  loadedAt      DateTime?
  handedOverAt  DateTime?
  totalWeightKg Float?
  totalVolumeM3 Float?
}

/// Versioned delivery note. Current row is the one with validTo = null.
model DeliveryNote {
  dnId         String
  versionAt    DateTime
  orderId      String
  order        Order                 @relation(fields: [orderId], references: [id])
  status       String?
  validTo      DateTime?
  changedById  String?
  changedBy    Loader?               @relation(fields: [changedById], references: [id])
  changeReason String?
  lines        DeliveryNoteLine[]
  loaders      DeliveryNoteLoader[]
  loaderFlags  LoaderFlag[]

  @@id([dnId, versionAt])
  @@index([dnId])
  @@index([orderId])
}

model DeliveryNoteLine {
  id             String             @id @default(cuid())
  dnId           String
  versionAt      DateTime
  note           DeliveryNote       @relation(fields: [dnId, versionAt], references: [dnId, versionAt], onDelete: Cascade)
  itemId         String
  item           Item               @relation(fields: [itemId], references: [id])
  qtyConfirmed   Float?
  shortageReason String?
  picks          DeliveryNotePick[]
}

model DeliveryNotePick {
  id       String           @id @default(cuid())
  dnLineId String
  line     DeliveryNoteLine @relation(fields: [dnLineId], references: [id], onDelete: Cascade)
  batchId  String
  batch    InventoryBatch   @relation(fields: [batchId], references: [id])
  qty      Float
}

model DeliveryNoteLoader {
  id         String         @id @default(cuid())
  dnId       String
  versionAt  DateTime
  note       DeliveryNote   @relation(fields: [dnId, versionAt], references: [dnId, versionAt], onDelete: Cascade)
  loaderId   String
  loader     Loader         @relation(fields: [loaderId], references: [id])
  role       LoaderNoteRole?
  startedAt  DateTime?
  finishedAt DateTime?

  @@unique([dnId, versionAt, loaderId])
}

/// Raised by the outlet (store), not the driver. Driver only sets driverDecision.
model FieldFlag {
  id               String            @id @default(cuid())
  raisedAt         DateTime          @default(now())
  storeId          String
  store            Store             @relation(fields: [storeId], references: [id])
  orderId          String
  order            Order             @relation(fields: [orderId], references: [id])
  tripId           String?
  trip             Trip?             @relation(fields: [tripId], references: [id])
  itemId           String?
  item             Item?             @relation(fields: [itemId], references: [id])
  qtyFlagged       Float?
  reason           String
  reasonDetail     String?
  severity         FlagSeverity?
  driverDecision   FieldFlagDecision @default(pending)
  driverDecidedAt  DateTime?
  driverNote       String?
  photoKey         String?
  resolvedAt       DateTime?

  @@index([orderId])
}

model LoaderFlag {
  id                String           @id @default(cuid())
  raisedAt          DateTime         @default(now())
  loaderId          String
  loader            Loader           @relation(fields: [loaderId], references: [id])
  dnId              String
  versionAt         DateTime
  note              DeliveryNote     @relation(fields: [dnId, versionAt], references: [dnId, versionAt], onDelete: Cascade)
  scope             LoaderFlagScope
  itemId            String?
  item              Item?            @relation(fields: [itemId], references: [id])
  qtyFlagged        Float?
  reason            String
  reasonDetail      String?
  photoKey          String?
  validationStatus  LoaderFlagStatus @default(pending_dispatcher)
  reviewedById      String?
  reviewedBy        Dispatcher?      @relation(fields: [reviewedById], references: [id])
  reviewedAt        DateTime?
  reviewNote        String?

  @@index([dnId])
}

model DriverIncident {
  id               String      @id @default(cuid())
  driverId         String
  driver           Driver      @relation(fields: [driverId], references: [id])
  tripId           String?
  trip             Trip?       @relation("DriverIncidentTrip", fields: [tripId], references: [id])
  vehicleId        String?
  vehicle          Vehicle?    @relation(fields: [vehicleId], references: [id])
  incidentType     String
  severity         SosSeverity
  message          String?
  lat              Float?
  lng              Float?
  lastStopId       String?
  lastStop         TripStop?   @relation(fields: [lastStopId], references: [id])
  raisedAt         DateTime    @default(now())
  acknowledgedAt   DateTime?
  acknowledgedBy   String?
  resolvedAt       DateTime?
  resolution       String?
  reassignedTripId String?
  reassignedTrip   Trip?       @relation("DriverIncidentReassign", fields: [reassignedTripId], references: [id])
}

/// GPS trail. Phone stores pings locally when offline, then POST /sync with clientUuid.
model LocationPing {
  id         String   @id @default(cuid())
  clientUuid String   @unique
  tripId     String
  trip       Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  driverId   String
  driver     Driver   @relation(fields: [driverId], references: [id])
  lat        Float
  lng        Float
  accuracyM  Float?
  speedKmh   Float?
  recordedAt DateTime
  receivedAt DateTime @default(now())

  @@index([tripId, recordedAt])
}
