  <diagram id="waypoint-sync-schema" name="Waypoint Sync Prisma">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3360" pageHeight="2920" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Waypoint Sync — Prisma schema (all tables)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="20" width="980" height="36" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="&lt;b&gt;How to read&lt;/b&gt;&lt;br&gt;Prisma is the source of truth. Field names match schema.prisma.&lt;br&gt;&lt;b&gt;1&lt;/b&gt; exactly one &amp;nbsp; &lt;b&gt;0..1&lt;/b&gt; zero or one &amp;nbsp; &lt;b&gt;0..*&lt;/b&gt; zero or more&lt;br&gt;Solid line = FK. Dashed line = lookup only (no FK).&lt;br&gt;Store = Outlet. User.role + Driver/Loader/Dispatcher = login people.&lt;br&gt;LoadSession = live dock. LoadingJob = dispatcher handoff.&lt;br&gt;Incident ≠ DriverIncident. photoKey / signaturePhotoKey = MinIO object names." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="2480" y="16" width="660" height="150" as="geometry" />
        </mxCell>
        <mxCell id="Depot" value="&lt;table style=&quot;width:100%;border-collapse:collapse;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;background-color:#f5f5f5;font-weight:bold;padding:6px;font-size:13px;&quot;&gt;Depot&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:8px;text-align:left;font-size:11px;&quot;&gt;id PK String&lt;br&gt;name String&lt;br&gt;telephone String?&lt;br&gt;email String?&lt;br&gt;address String?&lt;br&gt;lat Float?&lt;br&gt;lng Float?&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="verticalAlign=top;align=center;overflow=fill;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="100" width="260" height="180" as="geometry" />
        </mxCell>
        <mxCell id="District" value="&lt;table style=&quot;width:100%;border-collapse:collapse;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;background-color:#f5f5f5;font-weight:bold;padding:6px;font-size:13px;&quot;&gt;District&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:8px;text-align:left;font-size:11px;&quot;&gt;name PK String&lt;br&gt;depotId FK Depot?&lt;br&gt;served Boolean&lt;br&gt;roadClass String?&lt;br&gt;freeFlowKmh Float?&lt;br&gt;depotToDistrictKm Float?&lt;br&gt;depotToDistrictMin Int?&lt;br&gt;interStopKm Float?&lt;br&gt;interStopMin Int?&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="verticalAlign=top;align=center;overflow=fill;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="480" y="100" width="260" height="230" as="geometry" />
        </mxCell>
