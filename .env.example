# Runtime mode
NODE_ENV=development
# Postgres connection used by the API (host "db" inside Compose; use localhost for local dev)
DATABASE_URL=postgresql://waypoint:waypoint@db:5432/waypoint
# Postgres container credentials
POSTGRES_USER=waypoint
POSTGRES_PASSWORD=waypoint
POSTGRES_DB=waypoint
# API listen port
PORT=3001
# Where Next.js rewrites /api/* to
API_INTERNAL_URL=http://localhost:3001
# Session lifetime in hours
SESSION_TTL_HOURS=12
# Folder containing the competition CSVs (/data in Docker)
DATA_DIR=/data
# Optional fixed "now" (ISO, Asia/Colombo) for demos, API side
DEMO_NOW=
# Same override for the browser
NEXT_PUBLIC_DEMO_NOW=
# Development only: 1 keeps store ordering open until 23:59 (default cutoff 16:00). Never for a demo.
ORDER_CUTOFF_OPEN=
# Development only: address of tools/local-admin (e.g. http://127.0.0.1:3099/); shows a Check link on sign-in
NEXT_PUBLIC_LOCAL_CHECK_URL=
# MinIO credentials
MINIO_ROOT_USER=waypoint
MINIO_ROOT_PASSWORD=waypoint-secret
# MinIO endpoint used by the API
MINIO_ENDPOINT=http://minio:9000
# Bucket for photos
MINIO_BUCKET=photos
# Local folder used when MinIO is unavailable
PHOTO_FALLBACK_DIR=/tmp/photos
# Nightly pg_dump (scripts/backup-db.sh on the VM)
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14
# Cloudflare Tunnel token (only for the "public" profile)
CLOUDFLARE_TUNNEL_TOKEN=
# npm registry used when building Docker images (set a mirror if registry.npmjs.org is blocked)
NPM_REGISTRY=https://registry.npmjs.org
# Optional Prisma engine download mirror for Docker builds
PRISMA_ENGINES_MIRROR=
# Go module proxy used when building MinIO from source
GOPROXY=https://proxy.golang.org,direct
