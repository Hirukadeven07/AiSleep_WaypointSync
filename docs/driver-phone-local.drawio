<mxfile host="Electron" agent="Draw.io Integration" version="22.1.22">
  <diagram id="driver-phone-local" name="Driver phone local store">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1760" pageHeight="1140" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="Waypoint Sync — driver phone local store (IndexedDB) and POST /api/sync" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="16" width="900" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="legend" value="&lt;b&gt;How to read&lt;/b&gt;&lt;br&gt;Phone = PWA. Local store is IndexedDB &lt;i&gt;waypoint_driver_db&lt;/i&gt; + localStorage, not a native .sqlite file.&lt;br&gt;Teal dashed arrow = sync when the browser is online. &lt;b&gt;clientId&lt;/b&gt; / &lt;b&gt;clientUuid&lt;/b&gt; is the dedupe key." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="980" y="12" width="750" height="72" as="geometry"/>
        </mxCell>

        <mxCell id="lane-phone" value="Phone — IndexedDB waypoint_driver_db (works with no signal)" style="swimlane;whiteSpace=wrap;html=1;startSize=30;fillColor=#e0f4f5;strokeColor=#0e8088;fontStyle=1;fontSize=13;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="30" y="100" width="520" height="540" as="geometry"/>
        </mxCell>
        <mxCell id="outbox" value="&lt;table style=&quot;width:100%;border-collapse:collapse;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;background-color:#b0e3e6;font-weight:bold;padding:6px;font-size:13px;&quot;&gt;outbox (append-only)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:8px;text-align:left;font-size:11px;&quot;&gt;id PK (local autoIncrement, not the server id)&lt;br&gt;clientId unique UUID (crypto.randomUUID)&lt;br&gt;driverId (User.id from /api/me)&lt;br&gt;tripId (null only for SOS with no trip)&lt;br&gt;type ARRIVED / WAITING / ACKNOWLEDGEMENT / ROAD_ISSUE / SOS_ALERT&lt;br&gt;payload JSON (stopId, lat, lng, flagId, …)&lt;br&gt;createdOnPhoneAt (phone clock, ISO)&lt;br&gt;seenPlanVersion (Trip.planVersion on screen)&lt;br&gt;status PENDING or SYNCED&lt;br&gt;indexes: by-clientId, by-status&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="verticalAlign=top;align=center;overflow=fill;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#0e8088;strokeWidth=1;" vertex="1" parent="lane-phone">
          <mxGeometry x="20" y="45" width="480" height="250" as="geometry"/>
        </mxCell>
        <mxCell id="gps-note" value="&lt;b&gt;GPS trail&lt;/b&gt; — not a second IndexedDB table.&lt;br&gt;Each ping is one outbox row (type in payload, e.g. location_ping) with lat/lng/accuracy/speed and its own clientId. Same drain path as arrive / SOS." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#ffffff;strokeColor=#0e8088;fontSize=11;" vertex="1" parent="lane-phone">
          <mxGeometry x="20" y="310" width="480" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="rules" value="&lt;b&gt;Rules&lt;/b&gt;&lt;br&gt;Every tap writes outbox first. Never edit or delete PENDING rows.&lt;br&gt;navigator.storage.persist() at driver login so iOS/Chrome do not evict the DB.&lt;br&gt;Share unsynced JSON (Files / AirDrop) is the stand-in for a Files-app dump — not Capacitor SQLite." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#ffffff;strokeColor=#0e8088;fontSize=11;" vertex="1" parent="lane-phone">
          <mxGeometry x="20" y="405" width="480" height="115" as="geometry"/>
        </mxCell>

        <mxCell id="lane-cache" value="Phone — localStorage cache (read-only copy)" style="swimlane;whiteSpace=wrap;html=1;startSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=13;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="570" y="100" width="340" height="540" as="geometry"/>
        </mxCell>
        <mxCell id="cache" value="&lt;table style=&quot;width:100%;border-collapse:collapse;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;background-color:#dae8fc;font-weight:bold;padding:6px;font-size:13px;&quot;&gt;ws_driver_shell_v1&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:8px;text-align:left;font-size:11px;&quot;&gt;me (id, loginId, role, name, depotId)&lt;br&gt;vehicle (id, plate, type)&lt;br&gt;trips[] (id, tripNumber, status, planVersion)&lt;br&gt;stops[] (id, sequence, outletName, address, status, window, eta)&lt;br&gt;cachedAt ISO&lt;br&gt;&lt;br&gt;Written after a successful GET /api/me and GET /api/driver/day.&lt;br&gt;Used only to paint the shell offline. Never the source of truth for actions.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="verticalAlign=top;align=center;overflow=fill;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1;" vertex="1" parent="lane-cache">
          <mxGeometry x="20" y="45" width="300" height="280" as="geometry"/>
        </mxCell>
        <mxCell id="share-note" value="After POST /api/sync returns 200, refresh this cache from GET. Plan-version mismatch: pause the drain until the driver accepts the new stop list, then resume." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="lane-cache">
          <mxGeometry x="20" y="340" width="300" height="175" as="geometry"/>
        </mxCell>

        <mxCell id="sync" value="&lt;table style=&quot;width:100%;border-collapse:collapse;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;background-color:#b0e3e6;font-weight:bold;padding:6px;font-size:13px;&quot;&gt;POST /api/sync&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:8px;text-align:left;font-size:11px;&quot;&gt;When: browser &lt;i&gt;online&lt;/i&gt;, app focus, every 60 s.&lt;br&gt;Body: PENDING rows via toSyncEvent() — strips local id and status.&lt;br&gt;Order: SOS_ALERT first, then oldest PENDING (ARRIVED before ACKNOWLEDGEMENT).&lt;br&gt;200 + accepted clientIds → markActionSynced.&lt;br&gt;Retries are safe: unique clientId / clientUuid on the server.&lt;br&gt;seenPlanVersion must match Trip.planVersion or the batch pauses.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="verticalAlign=top;align=center;overflow=fill;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#0e8088;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="930" y="250" width="280" height="280" as="geometry"/>
        </mxCell>

        <mxCell id="lane-server" value="Server Postgres (Prisma — already in schema.prisma)" style="swimlane;whiteSpace=wrap;html=1;startSize=30;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=13;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1230" y="100" width="500" height="980" as="geometry"/>
        </mxCell>
        <mxCell id="drv-event" value="&lt;table style=&quot;width:100%;border-collapse:collapse;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;background-color:#f8cecc;font-weight:bold;padding:6px;font-size:13px;&quot;&gt;DriverEvent (audit of every phone action)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:8px;text-align:left;font-size:11px;&quot;&gt;id PK&lt;br&gt;clientId unique ← outbox.clientId&lt;br&gt;driverId, tripId FK, type, payload JSON&lt;br&gt;createdOnPhoneAt, seenPlanVersion, appliedAt&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="verticalAlign=top;align=center;overflow=fill;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#b85450;strokeWidth=1;" vertex="1" parent="lane-server">
          <mxGeometry x="20" y="45" width="460" height="145" as="geometry"/>
        </mxCell>
        <mxCell id="loc-ping" value="&lt;table style=&quot;width:100%;border-collapse:collapse;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;background-color:#f8cecc;font-weight:bold;padding:6px;font-size:13px;&quot;&gt;LocationPing (GPS trail on the dispatcher map)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:8px;text-align:left;font-size:11px;&quot;&gt;id PK&lt;br&gt;clientUuid unique ← outbox.clientId&lt;br&gt;tripId FK, driverId FK, lat, lng, accuracyM, speedKmh&lt;br&gt;recordedAt (phone clock) · receivedAt (server clock)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="verticalAlign=top;align=center;overflow=fill;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#b85450;strokeWidth=1;" vertex="1" parent="lane-server">
          <mxGeometry x="20" y="205" width="460" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="trip-stop" value="&lt;table style=&quot;width:100%;border-collapse:collapse;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;background-color:#f8cecc;font-weight:bold;padding:6px;font-size:13px;&quot;&gt;TripStop&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:8px;text-align:left;font-size:11px;&quot;&gt;ARRIVED → arrivedAt, status waiting&lt;br&gt;WAITING → wait started&lt;br&gt;ACKNOWLEDGEMENT → driverAckAt&lt;br&gt;leave in payload → leaveOutletTime, serviceMin&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="verticalAlign=top;align=center;overflow=fill;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#b85450;strokeWidth=1;" vertex="1" parent="lane-server">
          <mxGeometry x="20" y="360" width="220" height="155" as="geometry"/>
        </mxCell>
        <mxCell id="drv-inc" value="&lt;table style=&quot;width:100%;border-collapse:collapse;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;background-color:#f8cecc;font-weight:bold;padding:6px;font-size:13px;&quot;&gt;DriverIncident&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:8px;text-align:left;font-size:11px;&quot;&gt;SOS_ALERT / ROAD_ISSUE&lt;br&gt;new row: type, severity, message, lat/lng, lastStopId, tripId, vehicleId&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="verticalAlign=top;align=center;overflow=fill;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#b85450;strokeWidth=1;" vertex="1" parent="lane-server">
          <mxGeometry x="260" y="360" width="220" height="155" as="geometry"/>
        </mxCell>
        <mxCell id="store-receipt" value="&lt;table style=&quot;width:100%;border-collapse:collapse;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;background-color:#d5e8d4;font-weight:bold;padding:6px;font-size:13px;&quot;&gt;StoreReceipt (POST /api/store/.../receipt, not /api/sync)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:8px;text-align:left;font-size:11px;&quot;&gt;stopId FK unique ← TripStop&lt;br&gt;photoKey (MinIO goods) · signaturePhotoKey (MinIO signature)&lt;br&gt;signedByUserId · signedAt&lt;br&gt;Driver displays via the key after store confirm. PNG is not in IndexedDB.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="verticalAlign=top;align=center;overflow=fill;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=1;" vertex="1" parent="lane-server">
          <mxGeometry x="20" y="530" width="460" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="field-flag" value="&lt;table style=&quot;width:100%;border-collapse:collapse;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;background-color:#f8cecc;font-weight:bold;padding:6px;font-size:13px;&quot;&gt;FieldFlag&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:8px;text-align:left;font-size:11px;&quot;&gt;Driver does not raise this. Payload flagId + decision → driverDecision accepted/rejected, driverDecidedAt, driverNote. photoKey (MinIO) on the row.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="verticalAlign=top;align=center;overflow=fill;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#b85450;strokeWidth=1;" vertex="1" parent="lane-server">
          <mxGeometry x="20" y="705" width="460" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="map-note" value="Every accepted event also inserts DriverEvent. Location pings insert LocationPing. Then GET /api/driver/day refreshes ws_driver_shell_v1." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;" vertex="1" parent="lane-server">
          <mxGeometry x="20" y="850" width="460" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="e-outbox-sync" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;startArrow=none;strokeWidth=1.5;dashed=1;dashPattern=8 8;strokeColor=#0e8088;exitX=1;exitY=0.45;exitDx=0;exitDy=0;entryX=0;entryY=0.35;entryDx=0;entryDy=0;" edge="1" parent="1" source="outbox" target="sync">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-outbox-sync-l" value="PENDING" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;fontStyle=1;fontColor=#0e8088;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="e-outbox-sync">
          <mxGeometry x="-0.1" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry>
        </mxCell>
        <mxCell id="e-sync-event" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;startArrow=none;strokeWidth=1.5;dashed=1;dashPattern=8 8;strokeColor=#0e8088;exitX=1;exitY=0.22;exitDx=0;exitDy=0;entryX=0;entryY=0.4;entryDx=0;entryDy=0;" edge="1" parent="1" source="sync" target="drv-event">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-sync-ping" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;startArrow=none;strokeWidth=1.5;dashed=1;dashPattern=8 8;strokeColor=#0e8088;exitX=1;exitY=0.4;exitDx=0;exitDy=0;entryX=0;entryY=0.45;entryDx=0;entryDy=0;" edge="1" parent="1" source="sync" target="loc-ping">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-sync-stop" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;startArrow=none;strokeWidth=1.5;dashed=1;dashPattern=8 8;strokeColor=#0e8088;exitX=1;exitY=0.58;exitDx=0;exitDy=0;entryX=0;entryY=0.35;entryDx=0;entryDy=0;" edge="1" parent="1" source="sync" target="trip-stop">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-sync-inc" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;startArrow=none;strokeWidth=1.5;dashed=1;dashPattern=8 8;strokeColor=#0e8088;exitX=1;exitY=0.72;exitDx=0;exitDy=0;entryX=0;entryY=0.4;entryDx=0;entryDy=0;" edge="1" parent="1" source="sync" target="drv-inc">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-sync-flag" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;startArrow=none;strokeWidth=1.5;dashed=1;dashPattern=8 8;strokeColor=#0e8088;exitX=1;exitY=0.88;exitDx=0;exitDy=0;entryX=0;entryY=0.4;entryDx=0;entryDy=0;" edge="1" parent="1" source="sync" target="field-flag">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-sync-cache" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;startArrow=none;strokeWidth=1.5;dashed=1;dashPattern=8 8;strokeColor=#6c8ebf;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.55;entryDx=0;entryDy=0;" edge="1" parent="1" source="sync" target="cache">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1070" y="200"/>
              <mxPoint x="930" y="200"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e-sync-cache-l" value="GET day" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;fontStyle=1;fontColor=#6c8ebf;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="e-sync-cache">
          <mxGeometry x="0.2" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry>
        </mxCell>

        <mxCell id="footer" value="Not built yet: the drain loop in outbox.ts and POST /api/sync (Sanaya + Nithika). Schema tables are already in Prisma. Do not replace IndexedDB with sql.js or Capacitor for this hackathon." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="30" y="660" width="880" height="50" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
